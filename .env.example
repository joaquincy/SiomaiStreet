SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-a-rotated-service-role-key
API_PORT=3001
# Set to true only when the API is behind a trusted reverse proxy.
TRUST_PROXY=false
# Franchise endpoint uses this exact IP allowlist, not TRUST_PROXY.
# Leave empty when clients connect directly. Never trust arbitrary forwarded IPs.
TRUSTED_PROXY_IPS=
# Generate a random secret of at least 32 characters; keep identical across replicas.
APPLICATION_RATE_SECRET=
# Required scanner on a loopback/private network; never expose port 3310 publicly.
# Missing/unavailable scanner rejects new applications; there is no production bypass.
CLAMD_HOST=
CLAMD_PORT=3310

# Separate random secret, at least 32 characters; server only. Rotation invalidates portal codes.
APPLICATION_PORTAL_SECRET=
# Publish only an owner-verified address. Blank displays an unavailable notice.
VITE_VERIFIED_FRANCHISE_SUPPORT_EMAIL=
